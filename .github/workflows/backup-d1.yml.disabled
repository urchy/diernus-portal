# GitHub Actions — D1 → R2 backup for the Diernus Portal
#
# Runs daily at 03:00 UTC (off-peak for EU + US). Exports the production D1
# to a dated SQL file, uploads to R2 under backups/prod/, and prunes anything
# older than 30 days.
#
# Required GitHub Secrets (Settings → Secrets and variables → Actions):
#   CLOUDFLARE_API_TOKEN    API token with D1:Read + R2:Edit on the diernus account
#   CLOUDFLARE_ACCOUNT_ID   15103fc0f7367d7fc72cab24473dc437
#
# Manual triggers:
#   workflow_dispatch  →  run on demand with optional `keep` input
#   workflow_dispatch + env=staging  →  back up staging instead (manual edit of inputs)
#
# Restore procedure (NOT triggered here — manual on purpose):
#   1. `make backup-restore DATE=YYYY-MM-DD`            (or workflow_dispatch + restore)
#   2. `cd worker && wrangler d1 execute diernus-portal-db --remote --file=../backups/db-YYYY-MM-DD.sql`
#
# To re-add a secret or rotate CLOUDFLARE_API_TOKEN, see
# https://dash.cloudflare.com/profile/api-tokens (template: "Edit Cloudflare Workers"
# + D1:Read + R2:Edit on the diernus account).

name: backup-d1

on:
  schedule:
    # 03:00 UTC = 04:00 Europe/Lisbon summer, 03:00 winter. Off-peak for both EU + US.
    - cron: '0 3 * * *'
  workflow_dispatch:
    inputs:
      keep:
        description: 'Retention in days (default 30)'
        required: false
        default: '30'
      env:
        description: 'Which D1 to back up (prod | staging)'
        required: false
        default: 'prod'

concurrency:
  # Don't cancel an in-flight backup if a new one is triggered (manual run during
  # the scheduled run). Serialise so we don't upload two backups of the same day.
  group: backup-d1
  cancel-in-progress: false

jobs:
  backup:
    name: backup / ${{ inputs.env || 'prod' }}
    runs-on: ubuntu-latest
    timeout-minutes: 15
    env:
      CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
      CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
      KEEP: ${{ inputs.keep || '30' }}
      ENV_NAME: ${{ inputs.env || 'prod' }}
    steps:
      - uses: actions/checkout@v4

      - name: Show preflight
        run: |
          echo "date_utc: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
          echo "env:      $ENV_NAME"
          echo "keep:     $KEEP"
          echo "token:    ${CLOUDFLARE_API_TOKEN:0:8}… (len=${#CLOUDFLARE_API_TOKEN})"
          echo "account:  $CLOUDFLARE_ACCOUNT_ID"

      - name: Install wrangler
        run: npm install -g wrangler@^3.99.0
        # Pin to ^3.99 to match the worker's local version (keeps d1/r2 commands
        # identical to what `make backup-prod` uses locally).

      - name: Run backup
        working-directory: ${{ github.workspace }}
        run: |
          ENV_NAME="$ENV_NAME" \
          KEEP_OVERRIDE="$KEEP" \
          bash scripts/backup-d1.sh

      - name: Report status
        if: always()
        run: |
          echo "----- result -----"
          echo "exit: ${{ steps.backup.outcome }}"
          echo "date: $(date -u +%Y-%m-%d)"
          echo
          echo "To list backups: wrangler r2 object list diernus-portal-files --prefix backups/$ENV_NAME/ --json"
          echo "To restore:      make backup-restore DATE=$(date -u +%Y-%m-%d)"
